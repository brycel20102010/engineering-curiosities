---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h3>Welcome to Engineering Curiosities!</h3>
			<p>
				I'm a fourth year Mechanical Engineering student with a focus on robotics and automation.
				This site serves as a catalouge of all my personal projects. 
			</p>
		</main>
		<Footer />
	</body>
</html>
